# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the Express API listens on (the client dev proxy expects 10000)
PORT=10000

# Allowed frontend origin for CORS (e.g. http://localhost:5173 in development)
CLIENT_URL=http://localhost:5173

# Optional: set to true to exit if the database can't connect on startup
DB_FAIL_FAST=false

# ---------------------------------------------------------------------------
# Database (MongoDB)
# ---------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>

# Optional: only needed if you hit `querySrv ECONNREFUSED` with mongodb+srv://
MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Secret used to sign login tokens (long random string, e.g. 64 hex characters)
JWT_SECRET=<random-64-hex-characters>

# AES-128-GCM key for encrypted text fields — exactly 32 hex characters
TEXT_ENCRYPTION_KEY=<32-hex-characters>

# AES-256-GCM key for encrypted question images — exactly 64 hex characters
IMAGE_ENCRYPTION_KEY=<64-hex-characters>

# ---------------------------------------------------------------------------
# AI question import (Google Gemini)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=<your-gemini-api-key>
# Models tried in order: when one is out of quota, the next one is used.
# Numbers set the order; gaps are fine and there is no maximum. To turn a
# model off, comment out its lines.
# _RPM / _RPD: requests per minute / per day this server may send the model,
# from the quota page in Google AI Studio. Daily limits reset at midnight
# Pacific time. Tokens per minute are not counted here: if Google's token
# limit is hit, the model is skipped like for any other limit.
GEMINI_MODEL_1=gemini-3.6-flash
GEMINI_MODEL_1_RPM=5
GEMINI_MODEL_1_RPD=20

GEMINI_MODEL_2=gemini-3.5-flash-lite
GEMINI_MODEL_2_RPM=15
GEMINI_MODEL_2_RPD=500

GEMINI_MODEL_3=gemini-3.1-flash-lite
GEMINI_MODEL_3_RPM=15
GEMINI_MODEL_3_RPD=500

GEMINI_MODEL_4=gemini-2.5-flash
GEMINI_MODEL_4_RPM=5
GEMINI_MODEL_4_RPD=20

GEMINI_MODEL_5=gemini-2.5-flash-lite
GEMINI_MODEL_5_RPM=10
GEMINI_MODEL_5_RPD=20

# Limits for a model without its own _RPM / _RPD
GEMINI_RPM_LIMIT=8
GEMINI_RPD_LIMIT=200

IMPORT_MAX_FILE_SIZE_MB=10
IMPORT_MAX_QUESTIONS=40
IMPORT_USER_HOURLY_LIMIT=8
IMPORT_USER_DAILY_LIMIT=20

# ---------------------------------------------------------------------------
# Image storage (Cloudflare R2, S3-compatible)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=<your-r2-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=<your-bucket-name>

# ---------------------------------------------------------------------------
# Email (Brevo)
# ---------------------------------------------------------------------------
BREVO_API_KEY=<your-brevo-api-key>
EMAIL_FROM=<sender-address@example.com>

# ---------------------------------------------------------------------------
# First super admin account (used only by `npm run seed:superadmin`)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=<admin-email@example.com>
SEED_ADMIN_PASSWORD=<strong-password>
SUPER_ADMIN_NAME=Super Admin
