# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the Express API listens on (the client dev proxy expects 10000)
PORT=10000

# Allowed frontend origin for CORS (e.g. http://localhost:5173 in development)
CLIENT_URL=http://localhost:5173

# Optional: set to true to exit if the database can't connect on startup
DB_FAIL_FAST=false

# ---------------------------------------------------------------------------
# Database (MongoDB)
# ---------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>

# Optional: only needed if you hit `querySrv ECONNREFUSED` with mongodb+srv://
MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Secret used to sign login tokens (long random string, e.g. 64 hex characters)
JWT_SECRET=<random-64-hex-characters>

# AES-128-GCM key for encrypted text fields — exactly 32 hex characters
TEXT_ENCRYPTION_KEY=<32-hex-characters>

# AES-256-GCM key for encrypted question images — exactly 64 hex characters
IMAGE_ENCRYPTION_KEY=<64-hex-characters>

# ---------------------------------------------------------------------------
# AI question import (Google Gemini)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM_LIMIT=8
GEMINI_RPD_LIMIT=200

IMPORT_MAX_FILE_SIZE_MB=10
IMPORT_MAX_QUESTIONS=20
IMPORT_USER_HOURLY_LIMIT=8
IMPORT_USER_DAILY_LIMIT=20

# ---------------------------------------------------------------------------
# Image storage (Cloudflare R2, S3-compatible)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=<your-r2-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=<your-bucket-name>

# ---------------------------------------------------------------------------
# Email (Brevo)
# ---------------------------------------------------------------------------
BREVO_API_KEY=<your-brevo-api-key>
EMAIL_FROM=<sender-address@example.com>

# ---------------------------------------------------------------------------
# First super admin account (used only by `npm run seed:superadmin`)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=<admin-email@example.com>
SEED_ADMIN_PASSWORD=<strong-password>
SUPER_ADMIN_NAME=Super Admin
